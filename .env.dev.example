# ── 개발 환경 환경변수 (개인 PC에서 build·실행) ──────────────────────────────
# 사용법: cp .env.dev.example .env.dev  (Windows: copy .env.dev.example .env.dev)
# 실행:   docker compose --env-file .env.dev -f docker-compose.dev.yml up --build
#         (--env-file 을 빼면 ${IMAGE_PATH} 등 치환값이 채워지지 않아 실패한다)
# 이 파일은 개발 전용이다. 운영용 .env 를 개인 PC로 복사하지 않는다.

# Django
DJANGO_SECRET_KEY=your-very-secret-key-change-me
DEBUG=True
# 내 PC에서만 쓰면 localhost,127.0.0.1 로 충분하다.
# 다른 사람이 http://<내 PC IP>:10011 로 접속하게 하려면 실제 IP를 추가한다 (예: XXX.XXX.X.XX)
ALLOWED_HOSTS=localhost,127.0.0.1

# Auth Mode (dev: 드롭다운 유저 선택, sso: OIDC 로그인)
AUTH_MODE=dev

# MySQL - 로컬 dev 컨테이너 (운영과 독립된 별개 서버)
CONTAINER_IMAGE=<your-container-registry>/mysql:8.0
MYSQL_HOST=db
MYSQL_DATABASE=requestdb_dev
MYSQL_DB=requestdb_dev
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password
MYSQL_ROOT_PASSWORD=your-root-password
MYSQL_PORT=3306

# DB 동기화 - 운영 MySQL 접속 정보 (db-sync 소스)
# SKIP_DB_SYNC=true(기본값)면 아래 값은 사용되지 않는다 — 개인 PC 기본 구성.
# 운영 DB를 복사하려면 SKIP_DB_SYNC=false 로 바꾸고 아래에 "운영 VM 의 IP" 를 넣는다.
#   - 운영 MySQL 은 docker-compose.yml 의 ports: 3306:3306 으로 VM 호스트에 노출되어 있다.
#   - VM 에서 IP 확인: hostname -I | awk '{print $1}'
#   - 전제: VM 방화벽이 내 PC 에서 오는 3306 접근을 허용하고,
#           MySQL 계정이 원격 호스트에서 접속 가능해야 한다.
PROD_MYSQL_HOST=<운영 VM IP>
PROD_MYSQL_DB=requestdb

# CORS - dev 포트(10011) 포함. 다른 PC 에서 내 개발 서버로 접속을 허용하려면
# http://<내 PC IP>:10011 형태로 추가한다.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:10011,http://127.0.0.1:10011

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# Approval email recipients (comma-separated)
APPROVAL_EMAIL_LIST=approver1@company.com,approver2@company.com

# DXHUB 메일 API (결재 단계 알림 발송)
DXHUB_MAIL_URL=https://your-dxhub-host
DXHUB_API_KEY=your-dxhub-api-key

# 외부 조회용 고정 API Key (읽기 전용 /api/external/v1/documents/ 접근)
EXTERNAL_API_KEY=

# 메일 본문에 포함될 웹 서비스 주소 (dev). 내 PC 에서만 확인하면 localhost 로 충분하다.
# 다른 사람도 메일 링크로 접속하게 하려면 내 PC IP 를 쓴다 (예: http://XXX.XXX.X.XX:10011)
FRONTEND_URL=http://localhost:10011
# 개발/검증용: 설정 시 모든 결재 알림 메일을 이 주소로 강제 발송
MAIL_REDIRECT_TO=wooyoung7.oh@company.com
# RTDB(MAIN) 동기화 실패 시 알림 메일 수신자 (콤마 구분, 비우면 실패해도 메일을 보내지 않음)
RTDB_SYNC_ALERT_MAIL=

# Dockerfile
# 아래 사내 저장소들은 내 PC 에서도 접근 가능해야 빌드가 된다(사내망/VPN).
IMAGE_PATH=<your-container-registry>/

# backend
PIP_INDEX_URL=http://<your-pypi-repository>/simple
PIP_TRUSTED_HOST=<your-pypi-host>
BIGDATA_INDEX_URL=http://<your-bigdata-repository>/simple
BIGDATA_TRUSTED_HOST=<your-bigdata-host>

# frontend
NPM_REGISTRY_URL=http://<your-npm-registry>

# dev 환경에서는 SKIP_SCHEDULER=true (빅데이터 동기화 비활성)
SKIP_SCHEDULER=true

# DB 동기화 제어
#   true  (기본값 / 개인 PC 권장): 운영 DB 에 접속하지 않고 내 PC 의 dev DB 를 그대로 유지
#   false (운영 VM 에서 dev 를 띄울 때): 재빌드 시마다 prod → dev 자동 복사
# 값을 지정하지 않으면 docker-compose.dev.yml 이 true 로 처리한다.
SKIP_DB_SYNC=true

# BDQ (Big Data Query) - 외부 DB 접근용
BDQ_ID=your-bdq-id
BDQ_PASSWORD=["your-bdq-password-1", "your-bdq-password-2"]

# ODBC - Cloudera Impala
ODBC_DRIVER_URL=http://<your-odbc-repository>/clouderaimpalaodbc_<version>_amd64.deb
ODBC_DRIVER_FILENAME=clouderaimpalaodbc_<version>_amd64.deb
ODBC_HOST=<your-impala-host>
ODBC_PORT=21050
ODBC_DATABASE=<your-database>
ODBC_AUTH_MECH=2
ODBC_USE_SASL=1
ODBC_UID=<your-odbc-username>
ODBC_PWD=<your-odbc-password>
ODBC_KRB_FQDN=_HOST
ODBC_KRB_REALM=
ODBC_KRB_SERVICE_NAME=impala
ODBC_SSL=0
ODBC_TSASL_BUFFER_SIZE=4000
ODBC_ROWS_PER_BLOCK=130000
